{
  "name": "JPH — Spin the Wheel, Steal the Deal",
  "short_name": "JPH Wheel",
  "description": "Kiosk prize wheel. Runs entirely offline on a single panel.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "portrait-primary",
  "background_color": "#303045",
